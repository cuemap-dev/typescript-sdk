{
  "name": "cuemap",
  "version": "0.7.3",
  "description": "CueMap TypeScript SDK - High-performance temporal-associative memory",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "default": "./dist/embedded.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "test:e2e": "CUEMAP_E2E=1 node --test test/*.test.js",
    "test:pack": "node scripts/verify-packed-install.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "temporal",
    "associative",
    "llm",
    "rag"
  ],
  "author": "Kaan Demirel <hello@cuemap.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuemap-dev/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/cuemap-dev/typescript-sdk/issues"
  },
  "homepage": "https://github.com/cuemap-dev/typescript-sdk/tree/main#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
